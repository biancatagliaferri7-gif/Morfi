{
  "name": "morfi",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "npm run test:orders && npm run test:order-stock-policy && npm run test:order-history && npm run test:order-errors && npm run test:calculations && npm run test:database && npm run test:auth && npm run test:reviews && npm run test:seller && npm run test:push",
    "test:order-history": "node --import=tsx --test test/order-history-migration.test.ts",
    "test:order-stock-policy": "node --import=tsx --test test/order-stock-policy.test.ts",
    "test:order-errors": "node --import=tsx --test test/order-errors.test.ts",
    "test:auth": "node --import=tsx --test test/password-errors.test.ts",
    "test:reviews": "node --import=tsx --test test/reviews.test.ts",
    "test:database": "node --import=tsx --test test/integration-migration.test.ts",
    "test:orders": "node --import=tsx --test test/orders.test.ts",
    "test:calculations": "node --import=tsx --test test/calculations.test.ts",
    "preview": "vite preview",
    "test:seller": "node --import=tsx --test test/seller-setup.test.ts",
    "test:push": "node --import=tsx --test test/push-notifications.test.ts",
    "test:e2e": "playwright test",
    "test:edge": "npx --yes deno@2.5.6 check --config supabase/functions/order-push/deno.json supabase/functions/order-push/index.ts && npx --yes deno@2.5.6 test --config supabase/functions/order-push/deno.json supabase/functions/order-push/webpush_test.ts",
    "test:pwa": "playwright test --config playwright.pwa.config.ts"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@playwright/test": "1.65.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^6.1.2",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^1.61.0",
    "maplibre-gl": "^6.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1"
  },
  "overrides": {
    "workbox-build": {
      "glob": "14.0.5"
    }
  }
}
